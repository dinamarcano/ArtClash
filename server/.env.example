# Copia este archivo como .env y llena los valores (el .env NO se sube a git).
# En Vercel, estas mismas variables van en Settings → Environment Variables
# del proyecto del SERVIDOR.

# Supabase → Connect → "Transaction pooler" (puerto 6543), con tu contraseña
DATABASE_URL=postgresql://postgres.xxxx:TU_PASSWORD@aws-0-xx.pooler.supabase.com:6543/postgres

# Clave para firmar los access tokens (JWT). Larga y aleatoria; genera una con:
#   node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_ACCESS_SECRET=cambia_esto_por_una_clave_larga_y_aleatoria

# Supabase Realtime (eventos en vivo). Supabase → Project Settings → API Keys
#   SUPABASE_URL: la "Project URL" (https://xxxx.supabase.co)
#   SUPABASE_SECRET_KEY: la clave SECRETA (sb_secret_... o la legacy "service_role").
#   ¡Solo en el servidor! Nunca en el cliente.
SUPABASE_URL=https://xxxx.supabase.co
SUPABASE_SECRET_KEY=sb_secret_xxxx

# URL del cliente para CORS (en Vercel: la URL del cliente, sin "/" al final)
CLIENT_URL=http://localhost:3000
