# Copia este archivo como .env.local y llena los valores (el .env.local NO se sube a git).
# En Vercel, estas mismas variables van en Settings → Environment Variables
# del proyecto del CLIENTE. Todo lo que empieza con NEXT_PUBLIC_ es visible
# en el navegador: aquí nunca van claves secretas.

# URL de nuestro servidor Express (en Vercel: la URL del servidor, sin "/" al final)
NEXT_PUBLIC_API_URL=http://localhost:3001

# Supabase Realtime, solo para ESCUCHAR eventos en vivo.
# Supabase → Project Settings → API Keys
#   NEXT_PUBLIC_SUPABASE_URL: la "Project URL" (la misma SUPABASE_URL del servidor)
#   NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY: la clave PÚBLICA (sb_publishable_... o la legacy "anon")
NEXT_PUBLIC_SUPABASE_URL=https://xxxx.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_xxxx
